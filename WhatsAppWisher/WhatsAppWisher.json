    {
      "parameters": {
        "jsCode": "// 1. Get today's date and format it to \"DD-MMM\"\nconst today = new Date();\nconst monthNames = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\nconst currentDay = String(today.getDate()).padStart(2, '0');\nconst currentMonth = monthNames[today.getMonth()];\nconst todayString = `${currentDay}-${currentMonth}`; \n\nconst eventsToday = [];\n\n// 2. Loop through all contacts\nfor (const item of $input.all()) {\n    const contact = item.json;\n    \n    // 3. Check for Birthdays\n    if (contact.Birthday === todayString) {\n        // We copy the contact data and append the GreetingType\n        eventsToday.push({ \n            json: { ...contact, GreetingType: \"Birthday\" } \n        });\n    }\n    \n    // 4. Check for Anniversaries\n    if (contact.Anniversary === todayString) {\n        eventsToday.push({ \n            json: { ...contact, GreetingType: \"Anniversary\" } \n        });\n    }\n}\n\n// 5. Return a standard flat array of objects for n8n's single output\nreturn eventsToday;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
