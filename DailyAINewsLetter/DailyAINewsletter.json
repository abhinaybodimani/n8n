        1104,
        96
      ],
      "id": "27d1cb6a-22d9-40ee-950a-ce5fe3f7beaa",
      "name": "AggregateAllItems"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI News Editor.\nRead the following AI news articles and select the TOP {{ $('ExtractConfigFile').item.json.data.settings.article_count }} most important news.\n\nIMPORTANT: Return ONLY a valid JSON object with exactly two fields. Do not wrap it in markdown code blocks.\n1. \"email_html\": The news formatted in standard HTML (using <h1>, <h2>, <p>, <strong>).\n2. \"whatsapp_text\": The exact same news formatted strictly for WhatsApp (no HTML, use single asterisks for *bold*).\n\nNews Data:\t\n{{ JSON.stringify($json.data) }}",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1328,
        96
      ],
      "id": "3e82e150-629c-4298-9744-ad2c3fb7f28b",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        1408,
        336
      ],
      "id": "d342de39-c2c0-49ac-ade2-b9d60b05bb4e",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "YourGeminiInstanceID",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let rawText = $json.text; \nlet cleanText = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\nreturn JSON.parse(cleanText);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        96
      ],
      "id": "4f5d58d9-8a18-44e2-9636-161a632327c2",
      "name": "ParseAIOutput_Json"
    },
    {
      "parameters": {
        "jsCode": "const subscribers = $('ExtractConfigFile').first().json.data.subscribers;\n\nlet contacts = [];\nfor (let sub of subscribers) {\n  contacts.push({\n    json: {\n      Email: sub.email || null, // Fallback if a user only has WhatsApp\n      WhatsApp: sub.whatsapp || null\n    }\n  });\n}\nreturn contacts;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        96
      ],
      "id": "856beee5-485e-48f1-9886-d5624efff124",
      "name": "DistributeList"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "YourSecretKey"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session\": \"YourSessionID\",\n  \"chatId\": \"{{ $json.WhatsApp }}\",\n  \"text\": {{ JSON.stringify($('ParseAIOutput_Json').first().json.whatsapp_text) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2352,
        0
      ],
      "id": "6c39d27f-d311-4911-acea-0c5393878fe4",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "fromEmail": "abhinaykumar15@gmail.com",
        "toEmail": "={{ $json.Email }}",
        "subject": "=Today AI News | {{$now.toFormat(\"dd MMM yyyy\")}}",
        "html": "={{ $('ParseAIOutput_Json').item.json.whatsapp_text }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2352,
        192
      ],
      "id": "42bbdcf0-9625-4884-99ff-f5c0fa8630bb",
      "name": "Send an Email",
      "webhookId": "da38e403-09d3-47e7-b2c4-4a0a70998f0b",
      "credentials": {
        "smtp": {
          "id": "YourGmailInstanceID",
          "name": "SMTP account"
        }
      }
    },
    {
