    {
      "parameters": {
        "jsCode": "// 1. Grab all the aggregated items coming out of the Loop's 'done' branch\nconst allItems = $input.all();\nconst flattenedItems = [];\n\n// Safely get the store name without crashing if the path is undefined\nlet defaultStore = \"$('FlattenTheData').first().json.Store\"\n\nfor (const item of allItems) {\n  let rawText = item.json.text;\n\n  // Skip if there's no text output\n  if (!rawText) continue;\n\n  try {\n    // 2. Strip out the ```json and ``` wrappers so it is pure JSON data\n    let cleanedText = rawText\n      .replace(/```json/gi, '')\n      .replace(/```/g, '')\n      .trim();\n\n    // 3. Parse the clean string back into a JavaScript array\n    const parsed = JSON.parse(cleanedText);\n\n    // 4. If the array has items, push them into our master list\n    if (Array.isArray(parsed) && parsed.length > 0) {\n      flattenedItems.push(...parsed);\n    }\n  } catch (e) {\n    // Skip this specific page if the JSON is somehow malformed\n  }\n}\n\n// 5. Output each deal as its own individual item for the database\nreturn flattenedItems.map(item => ({\n  json: {\n    item_name_dk: item.item_name_dk,\n    item_name_en: item.item_name_en,\n    category: item.category,\n    price: Number(item.price),\n    unit: item.unit,\n    // Clean up empty or 'Unknown' store names generated by the AI\n    store: (item.store && item.store !== \"Unknown\" && item.store !== \"\") \n           ? item.store \n           : defaultStore,\n    extracted_at: new Date().toISOString()\n  }\n}));"
      },
