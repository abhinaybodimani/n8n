    {
      "parameters": {
        "jsCode": "// 1. Get raw HTML from the previous HTTP Request node\nconst html = $input.first().json.data; \n\n// 2. Extract all hidden <app-data> blocks\nconst regex = /<app-data[^>]*>(.*?)<\\/app-data>/g;\nconst matches = [...html.matchAll(regex)];\n\nlet selectedPublication = null;\nconst now = new Date();\n\nfor (const match of matches) {\n  try {\n    // Convert HTML entity quotes (&quot;) back to standard quotes (\")\n    const cleanJson = match[1].replace(/&quot;/g, '\"');\n    const data = JSON.parse(cleanJson);\n\n    // Locate the block containing the publications array\n    if (Array.isArray(data) && data[0] && Array.isArray(data[0].publications)) {\n      const publications = data[0].publications;\n\n      // Filter for flyers that are currently active right now\n      const activePublications = publications.filter(p => {\n        const from = new Date(p.validFrom);\n        const until = new Date(p.validUntil);\n        return from <= now && until >= now;\n      });\n\n      if (activePublications.length > 0) {\n        // Prioritize the weekly flyer (typically labeled 'Uge X')\n        const weeklyGroceryFlyer = activePublications.find(p => \n          p.label && p.label.toLowerCase().includes('uge')\n        );\n\n        // Fall back to the first active circular if 'Uge' isn't explicitly in the title\n        selectedPublication = weeklyGroceryFlyer || activePublications[0];\n        break; \n      }\n    }\n  } catch (e) {\n    // Skip blocks that fail JSON parsing\n  }\n}\n\nif (!selectedPublication) {\n  throw new Error(\"No active weekly grocery flyer found for this store.\");\n}\n\n// 3. Return the publication details for downstream nodes\nreturn [{\n  json: {\n    publicationId: selectedPublication.id,\n    label: selectedPublication.label,\n    validFrom: selectedPublication.validFrom,\n    validUntil: selectedPublication.validUntil\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        144
      ],
      "id": "22d02f0a-d560-4f1a-a762-6e3e0e4bbd77",
      "name": "RetrievePublicationID"
    },
    {
      "parameters": {
        "url": "={{ $('ExtractStores').item.json.data.URL }}{{ $('ExtractStores').item.json.data.stores[0].store }}?publication={{ $('RetrievePublicationID').item.json.publicationId }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
