      ],
      "id": "8cedb897-2f95-40be-966c-d06b8d46bb34",
      "name": "FetchFlyers"
    },
    {
      "parameters": {
        "jsCode": "// 1. Get the raw HTML from the previous HTTP Request\nconst html = $input.first().json.data; \n\n// 2. Find all hidden <app-data> blocks\nconst regex = /<app-data[^>]*>(.*?)<\\/app-data>/g;\nconst matches = [...html.matchAll(regex)];\n\nlet flyerPages = [];\n\nfor (const match of matches) {\n  try {\n    // 3. Clean the HTML formatting back to standard JSON\n    const cleanJson = match[1].replace(/&quot;/g, '\"');\n    const data = JSON.parse(cleanJson);\n\n    // 4. Look for the specific block holding the publication images\n    if (data.publication && data.publication.images) {\n      // Extract the URL and fix HTML entities (&amp; -> &)\n      flyerPages = data.publication.images.map(img => img.url.replace(/&amp;/g, '&'));\n      break; \n    }\n  } catch (e) {\n    // Ignore invalid JSON blocks\n  }\n}\n\nif (flyerPages.length === 0) {\n  throw new Error(\"Could not find image URLs in the HTML.\");\n}\n\n// 5. Output each URL as a separate item for the loop\nreturn flyerPages.map(url => ({\n  json: { \n    imageUrl: url \n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
